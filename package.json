    "probe": "tsx scripts/probe.ts",
    "pq": "tsx scripts/cli.ts",
    "evidence": "tsx scripts/evidence.ts",
    "cbom": "tsx scripts/cbom.ts --chain",
    "cbom:check": "tsx scripts/cbom.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "0.39.0",
    "@noble/hashes": "2.4.0",
    "@qorechain/evm": "0.14.0",
    "@qorechain/mcp": "0.1.1",
    "@qorechain/pqc": "0.2.3",
    "@qorechain/qore-cli": "0.1.1",
    "@qorechain/qoreseal": "0.1.0",
    "@qorechain/qoresign": "0.1.0",
    "@qorechain/sdk": "0.14.0",
    "viem": "2.47.6"
  },
  "devDependencies": {
    "@qorechain/qorescan": "0.1.0",
    "@types/node": "22.19.1",
    "tsx": "4.19.4",
    "typescript": "5.6.3",
