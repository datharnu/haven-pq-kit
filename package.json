{
  "name": "haven-pq-kit",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Shared post-quantum toolkit for Haven on QoreChain.",
  "exports": {
    ".": "./src/ts/index.ts",
    "./pqauth": "./src/ts/pqauth.ts",
    "./quorum": "./src/ts/quorum.ts",
    "./vendor": "./src/ts/vendor.ts",
    "./rest": "./src/ts/rest.ts",
    "./rest-proxy": "./src/ts/rest-proxy.ts",
    "./keydir": "./src/ts/keydir.ts",
    "./network": "./src/ts/network.ts"
  },
  "scripts": {
    "test:sol": "scripts/forge.sh test",
    "test:ts": "vitest run",
