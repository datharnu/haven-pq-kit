    "probe": "tsx scripts/probe.ts",
    "pq": "tsx scripts/cli.ts",
    "evidence": "tsx scripts/evidence.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@qorechain/evm": "0.14.0",
    "@qorechain/pqc": "0.2.3",
    "@qorechain/sdk": "0.14.0",
    "viem": "2.47.6"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.4",
    "typescript": "5.6.3"
  }
}
