{
  "name": "haven-pq-kit",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Shared post-quantum toolkit for Haven on QoreChain.",
  "exports": {
    ".": "./src/ts/index.ts",
